# Key names only. Values live in Infisical and are injected at run time:
#   infisical run --env=dev -- <command>
# All of these already exist in the dev environment.

# Orchestrator only. Never set on experiment pods.
RUNPOD_API_KEY=

# Experiment pods: model/dataset pull, result push, Trackio Space sync.
HF_TOKEN=

# Image build only. Doubles as the GHCR credential (needs write:packages).
GITHUB_TOKEN=

# Machine identity for non-interactive pods (Infisical Universal Auth).
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
